#!/usr/bin/env bash
# ==============================================================================
# 🛰️ RTL8812AU Pentest & Daily Dual-Mode Toggle
# High-Gain 802.11ac 2T2R Adapter Automation Suite
#
# Transitions:
#   [1] MANAGED: Everyday high-speed Wi-Fi (NetworkManager managed)
#   [2] MONITOR: Penetration testing mode (Packet Injection, Wireshark, Kitty)
# ==============================================================================

set -o pipefail

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rtl8812au_monitor.state"
HELPER_BIN="/usr/local/bin/rtl8812au-monitor-helper"
[ ! -x "$HELPER_BIN" ] && HELPER_BIN="/opt/rtl8812au-wps-toggle/bin/rtl8812au-monitor-helper"

# Загрузка локализации и конфигурации
CONFIG_FILE="${HOME}/.config/rtl8812au-toggle/config.env"
[ ! -f "$CONFIG_FILE" ] && CONFIG_FILE="/opt/rtl8812au-wps-toggle/config.env"
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

# Значения по умолчанию, если не заданы в config.env
NOTIFY_APP_NAME="${NOTIFY_APP_NAME:-RTL8812AU CyberLink}"
NOTIFY_ON_TITLE="${NOTIFY_ON_TITLE:-🎯 RTL8812AU: Pentest Mode [ВКЛЮЧЕН]}"
NOTIFY_ON_MSG="${NOTIFY_ON_MSG:-Интерфейс: <b>%IFACE%</b> [MONITOR]\nWireshark и Kitty открыты.\nОсновной интернет ноута активен.}"
NOTIFY_OFF_TITLE="${NOTIFY_OFF_TITLE:-🟢 RTL8812AU: Обычный режим [ВЫКЛЮЧЕН]}"
NOTIFY_OFF_MSG="${NOTIFY_OFF_MSG:-Пентест завершен, окна закрыты.\nИнтерфейс <b>%IFACE%</b> возвращен в NetworkManager.}"
KITTY_TITLE="${KITTY_TITLE:-RTL8812AU Pentest Console [%IFACE%]}"
WIRESHARK_PRE_DELAY="${WIRESHARK_PRE_DELAY:-0.5}"
BANNER_SUBTITLE="${BANNER_SUBTITLE:-═════ RTL8812AU BOOTED // MONITOR MODE ACTIVE ═════}"
HINT_TITLE="${HINT_TITLE:-[i] Быстрые команды:}"
HINT_CMD1="${HINT_CMD1:-airodump-ng %IFACE%              # Обзор эфира 2.4 GHz}"
HINT_CMD2="${HINT_CMD2:-airodump-ng --band a %IFACE%     # Обзор эфира 5 GHz}"
HINT_CMD3="${HINT_CMD3:-aireplay-ng --test %IFACE%       # Проверка инъекции пакетов}"
HINT_CMD4="${HINT_CMD4:-Нажмите кнопку WPS на свистке   # Завершить пентест и закрыть окна}"
STATUS_READY="${STATUS_READY:-[✓] Среда готова к работе! Консоль открыта в интерактивном режиме.}"
PROMPT_STYLE="${PROMPT_STYLE:-┌──[PENTEST]─[%IFACE%]─[MONITOR]\n└──╼ }"

# ANSI Colors
C_RESET="\e[0m"
C_BOLD="\e[1m"
C_CYAN="\e[1;36m"
C_GREEN="\e[1;32m"
C_YELLOW="\e[1;33m"
C_RED="\e[1;31m"
C_MAGENTA="\e[1;35m"

# Автоэкспорт окружения GUI/Wayland
export DISPLAY="${DISPLAY:-:0}"
if [ -z "$WAYLAND_DISPLAY" ] && [ -e "${XDG_RUNTIME_DIR:-/run/user/1000}/wayland-0" ]; then
    export WAYLAND_DISPLAY="wayland-0"
fi
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "${XDG_RUNTIME_DIR:-/run/user/1000}/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/1000}/bus"
fi

send_notify() {
    local urgency="$1"
    local icon="$2"
    local title="$3"
    local msg="$4"
    if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        notify-send -u "$urgency" -i "$icon" -a "$NOTIFY_APP_NAME" "$title" "$msg" 2>/dev/null || true
    fi
}

play_sound() {
    local sound="$1"
    if [ -f "/usr/share/sounds/freedesktop/stereo/$sound" ]; then
        paplay "/usr/share/sounds/freedesktop/stereo/$sound" 2>/dev/null &
    fi
}

# Динамический поиск сетевого интерфейса RTL8812AU
find_rtl8812_iface() {
    local iface=""
    for dev in /sys/class/net/*; do
        local candidate
        candidate=$(basename "$dev")
        if [ -e "$dev/device/driver" ]; then
            local drv
            drv=$(basename "$(readlink "$dev/device/driver" 2>/dev/null || true)")
            local uevent
            uevent=$(cat "$dev/device/uevent" 2>/dev/null || true)
            if [[ "$drv" =~ 8812 ]] || [[ "$uevent" =~ 0BDA/8812 ]] || [[ "$uevent" =~ 0bda/8812 ]]; then
                iface="$candidate"
                break
            fi
        fi
    done

    if [ -z "$iface" ]; then
        for line in $(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do
            local sys_drv
            sys_drv=$(readlink "/sys/class/net/$line/device/driver" 2>/dev/null || true)
            if [[ "$sys_drv" =~ 8812 ]]; then
                iface="$line"
                break
            fi
        done
    fi

    echo "$iface"
}

# === ENABLE MONITOR MODE (PENTEST) ===
enable_monitor_mode() {
    local iface="$1"
    echo -e "${C_BOLD}${C_YELLOW}[*] RTL8812AU обнаружен: ${C_CYAN}${iface}${C_RESET}"

    # Звуковой сигнал и аппаратный импульс индикатора
    play_sound "device-added.oga"
    sudo "$HELPER_BIN" led-pulse 2>/dev/null &

    # Изолируем ТОЛЬКО этот адаптер от NetworkManager (основной Wi-Fi ноута НЕ прерывается!)
    echo -e "${C_YELLOW}[*] Изолируем $iface от NetworkManager (основной Wi-Fi работает без пауз)...${C_RESET}"
    nmcli device set "$iface" managed no 2>/dev/null || true
    sleep 0.15

    # Переводим физический интерфейс в monitor mode
    echo -e "${C_YELLOW}[*] Переключение $iface в режим монитора...${C_RESET}"
    if ! sudo "$HELPER_BIN" monitor "$iface"; then
        echo -e "${C_RED}[-] Ошибка включения режима монитора!${C_RESET}"
        send_notify "critical" "dialog-error" "❌ Ошибка RTL8812AU" "Не удалось перевести $iface в режим монитора"
        nmcli device set "$iface" managed yes 2>/dev/null || true
        return 1
    fi

    # 1. СНАЧАЛА ЗАПУСКАЕМ WIRESHARK (на задний план)
    echo -e "${C_CYAN}[*] [1/2] Запуск Wireshark на интерфейсе $iface...${C_RESET}"
    pkill -f "wireshark.*-i $iface" 2>/dev/null || true
    wireshark -C "Pentest-WiFi" -k -i "$iface" >/dev/null 2>&1 &
    local ws_pid=$!

    # Пауза, чтобы Wireshark успел проинициализировать окно
    sleep "$WIRESHARK_PRE_DELAY"

    # 2. ЗАТЕМ ЗАПУСКАЕМ KITTY (поверх Wireshark, в фокусе)
    echo -e "${C_CYAN}[*] [2/2] Запуск Kitty Pentest Console (на передний план)...${C_RESET}"
    pkill -f "rtl8812au-pentest" 2>/dev/null || true

    local win_title="${KITTY_TITLE//%IFACE%/$iface}"
    local p_style="${PROMPT_STYLE//%IFACE%/$iface}"
    local h_cmd1="${HINT_CMD1//%IFACE%/$iface}"
    local h_cmd2="${HINT_CMD2//%IFACE%/$iface}"
    local h_cmd3="${HINT_CMD3//%IFACE%/$iface}"
    local h_cmd4="${HINT_CMD4//%IFACE%/$iface}"

    kitty --class "rtl8812au-pentest" --title "$win_title" env SKIP_HI=1 NO_HI=1 bash -c "
clear
echo -e '\e[1;38;2;255;40;50m'
cat << 'ASCII'
  ██████╗ ████████╗██╗     ██████╗  █████╗  ██╗██████╗  █████╗ ██╗   ██╗
  ██╔══██╗╚══██╔══╝██║     ╚════██╗██╔══██╗███║╚════██╗██╔══██╗██║   ██║
  ██████╔╝   ██║   ██║      █████╔╝╚█████╔╝╚██║ █████╔╝███████║██║   ██║
  ██╔══██╗   ██║   ██║     ██╔═══╝ ██╔══██╗ ██║██╔═══╝ ██╔══██║██║   ██║
  ██║  ██║   ██║   ███████╗███████╗╚█████╔╝ ██║███████╗██║  ██║╚██████╔╝
ASCII
echo -e '\e[1;38;2;255;75;80m       $BANNER_SUBTITLE\e[0m'
echo -e '\e[1;36m[*] Сетевой интерфейс:\e[0m \e[1;32m$iface\e[0m'
echo -e '\e[1;36m[*] Чипсет:\e[0m           Realtek RTL8812AU (802.11a/b/g/n/ac 2T2R Dual-Band)'
echo -e '\e[1;36m[*] Инъекция пакетов:\e[0m \e[1;32m100% Native Injection Working\e[0m'
echo -e '\e[1;36m[*] Wireshark:\e[0m        \e[1;32mЗапущен на $iface (Live Capture на заднем плане)\e[0m'
echo -e '\e[1;36m[*] Сеть ноутбука:\e[0m    \e[1;32mОсновной Wi-Fi АКТИВЕН (интернет работает)\e[0m\n'

echo -e '\e[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m'
echo -e '\e[1;32m$STATUS_READY\e[0m'
echo -e '\e[1;36m$HINT_TITLE\e[0m'
echo -e '    \e[1;33m$h_cmd1\e[0m'
echo -e '    \e[1;33m$h_cmd2\e[0m'
echo -e '    \e[1;33m$h_cmd3\e[0m'
echo -e '    \e[1;33m$h_cmd4\e[0m'
echo -e '\e[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m\n'

export PS1=\"\[\e[1;38;2;255;40;50m\]$p_style\[\e[0m\]\"
exec bash -i
" >/dev/null 2>&1 &
    local kitty_pid=$!

    # Сохраняем состояние
    cat << EOF > "$STATE_FILE"
IFACE=$iface
WIRESHARK_PID=$ws_pid
KITTY_PID=$kitty_pid
MODE=monitor
EOF

    # Уведомление на рабочий стол
    local notif_msg="${NOTIFY_ON_MSG//%IFACE%/$iface}"
    local notif_title="${NOTIFY_ON_TITLE//%IFACE%/$iface}"
    send_notify "normal" "security-high" "$notif_title" "$notif_msg"

    echo -e "${C_GREEN}[✓] Боевой режим успешно активирован!${C_RESET}"
}

# === DISABLE MONITOR MODE (NORMAL/MANAGED) ===
disable_monitor_mode() {
    local iface="$1"
    local ws_pid="$2"
    local kitty_pid="$3"

    echo -e "${C_BOLD}${C_YELLOW}[*] Отключаем Monitor Mode на интерфейсе: ${C_CYAN}${iface}${C_RESET}"

    # Звуковой сигнал выключения
    play_sound "device-removed.oga"

    # Закрываем окно Kitty
    echo -e "${C_YELLOW}[*] Закрываем Kitty Pentest Console...${C_RESET}"
    pkill -f "rtl8812au-pentest" 2>/dev/null || true
    [ -n "$kitty_pid" ] && kill -9 "$kitty_pid" 2>/dev/null || true

    # Закрываем Wireshark
    echo -e "${C_YELLOW}[*] Закрываем Wireshark...${C_RESET}"
    pkill -f "wireshark.*-i" 2>/dev/null || true
    [ -n "$ws_pid" ] && kill -9 "$ws_pid" 2>/dev/null || true

    # Переводим интерфейс обратно в Managed Mode
    echo -e "${C_YELLOW}[*] Переводим $iface в Managed Mode...${C_RESET}"
    sudo "$HELPER_BIN" managed "$iface" 2>/dev/null || true

    # Возвращаем управление адаптером в NetworkManager (БЕЗ перезапуска всей службы сети!)
    echo -e "${C_YELLOW}[*] Возвращаем $iface в NetworkManager...${C_RESET}"
    nmcli device set "$iface" managed yes 2>/dev/null || true

    # Удаляем файл состояния
    rm -f "$STATE_FILE"

    # Уведомление на рабочий стол
    local notif_msg="${NOTIFY_OFF_MSG//%IFACE%/$iface}"
    local notif_title="${NOTIFY_OFF_TITLE//%IFACE%/$iface}"
    send_notify "normal" "network-wireless-connected" "$notif_title" "$notif_msg"

    echo -e "${C_GREEN}[✓] RTL8812AU успешно возвращен в штатный режим!${C_RESET}"
}

# --- Главная точка входа ---
IFACE=$(find_rtl8812_iface)
if [ -z "$IFACE" ]; then
    echo -e "${C_RED}[-] RTL8812AU адаптер не обнаружен! Проверьте USB подключение.${C_RESET}"
    send_notify "critical" "dialog-warning" "⚠️ RTL8812AU не найден" "Убедитесь, что USB-адаптер вставлен в порт."
    exit 1
fi

CURRENT_TYPE=$(iw dev "$IFACE" info 2>/dev/null | awk '$1=="type"{print $2}')

if [ -f "$STATE_FILE" ] || [ "$CURRENT_TYPE" = "monitor" ]; then
    if [ -f "$STATE_FILE" ]; then
        source "$STATE_FILE"
    fi
    disable_monitor_mode "$IFACE" "$WIRESHARK_PID" "$KITTY_PID"
else
    enable_monitor_mode "$IFACE"
fi
