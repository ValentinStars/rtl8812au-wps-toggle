#!/usr/bin/env bash
# ==============================================================================
# RTL8812AU Privileged Mode Switching Helper
# Controlled execution via sudoers without password prompt
# ==============================================================================

set -e

ACTION="$1"
IFACE="$2"

led_blink() {
    local leds=("/sys/class/leds/tpacpi::thinklight" "/sys/class/leds/tpacpi::lid_logo_dot")
    for _ in {1..3}; do
        for led in "${leds[@]}"; do
            [ -w "$led/brightness" ] && echo 1 > "$led/brightness" 2>/dev/null || true
        done
        sleep 0.08
        for led in "${leds[@]}"; do
            [ -w "$led/brightness" ] && echo 0 > "$led/brightness" 2>/dev/null || true
        done
        sleep 0.08
    done
}

case "$ACTION" in
    monitor)
        [ -z "$IFACE" ] && { echo "Missing interface argument"; exit 1; }
        ip link set "$IFACE" down
        iw dev "$IFACE" set type monitor
        ip link set "$IFACE" up
        led_blink &
        echo "MONITOR_OK"
        ;;
    managed)
        [ -z "$IFACE" ] && { echo "Missing interface argument"; exit 1; }
        ip link set "$IFACE" down
        iw dev "$IFACE" set type managed
        ip link set "$IFACE" up
        echo "MANAGED_OK"
        ;;
    led-pulse)
        led_blink
        ;;
    *)
        echo "Usage: $0 {monitor|managed|led-pulse} <iface>"
        exit 1
        ;;
esac
