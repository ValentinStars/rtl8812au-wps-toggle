# ==============================================================================
# 🛰️ RTL8812AU WPS Toggle - Configuration & Localization
# Здесь можно изменить любые тексты, баннеры, заголовки и уведомления.
# ==============================================================================

# --- Уведомления рабочего стола (notify-send) ---
NOTIFY_APP_NAME="RTL8812AU CyberLink"
NOTIFY_ON_TITLE="🎯 RTL8812AU: Pentest Mode [ВКЛЮЧЕН]"
NOTIFY_ON_MSG="Интерфейс: <b>%IFACE%</b> [MONITOR]\nWireshark и Kitty открыты.\nОсновной интернет ноута не прерывался!\nНажмите WPS на свистке для выключения."

NOTIFY_OFF_TITLE="🟢 RTL8812AU: Обычный режим [ВЫКЛЮЧЕН]"
NOTIFY_OFF_MSG="Пентест завершен, окна закрыты.\nИнтерфейс <b>%IFACE%</b> возвращен в NetworkManager.\nКлиентский Wi-Fi активен."

# --- Заголовки окон ---
KITTY_TITLE="RTL8812AU Pentest Console [%IFACE%]"

# --- Wireshark: Профиль оформления и темы ---
# Доступные профили: "Material-Dark", "Dracula", "Pentest-WiFi"
WIRESHARK_PROFILE="Material-Dark"

# --- Порядок и пауза запуска ---
# Сначала стартует Wireshark, затем через эту паузу открывается Kitty поверх него
WIRESHARK_PRE_DELAY=0.5

# --- Терминал: цвета и оформление ---
# Подзаголовок под логотипом
BANNER_SUBTITLE="═════ RTL8812AU BOOTED // MONITOR MODE ACTIVE ═════"

# Подсказки по командам внутри терминала
HINT_TITLE="[i] Быстрые команды:"
HINT_CMD1="airodump-ng %IFACE%              # Обзор эфира 2.4 GHz"
HINT_CMD2="airodump-ng --band a %IFACE%     # Обзор эфира 5 GHz"
HINT_CMD3="aireplay-ng --test %IFACE%       # Проверка инъекции пакетов"
HINT_CMD4="Нажмите кнопку WPS на свистке   # Завершить пентест и закрыть окна"
STATUS_READY="[✓] Среда готова к работе! Консоль открыта в интерактивном режиме."

# Командная строка (Prompt / PS1)
PROMPT_STYLE="┌──[PENTEST]─[%IFACE%]─[MONITOR]\n└──╼ "
